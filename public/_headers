# Cloudflare Workers static assets reads this file from the deployed bundle.
# The site previously served none of these.

/*
  # Stops MIME sniffing turning an uploaded file into executable script.
  X-Content-Type-Options: nosniff

  # Clickjacking guard. SAMEORIGIN rather than DENY so the app can still frame
  # its own pages if a future embed needs it.
  X-Frame-Options: SAMEORIGIN

  # Don't leak full URLs (which contain course/chapter/lead ids) to third
  # parties in the Referer header.
  Referrer-Policy: strict-origin-when-cross-origin

  # The lesson recorder needs all three: a screen share, a webcam and a mic.
  # This used to read `microphone=(), camera=()` — a site-wide ban the browser
  # enforces *before* it ever prompts, so every recording in the course builder
  # and the video library failed with "Permission denied" whatever the user
  # clicked. `(self)` grants them to this origin only; a third-party iframe
  # embedded in a page still gets nothing.
  Permissions-Policy: geolocation=(), microphone=(self), camera=(self), display-capture=(self), payment=(), usb=(), interest-cohort=()

  # Force HTTPS for a year. Add `preload` only once you are certain every
  # subdomain is HTTPS-only — it is hard to reverse.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Report-Only on purpose. Media is served from object storage whose public
  # hostname is configured at runtime (STORAGE_PUBLIC_URL), so an enforcing
  # policy risks blanking out real content. Watch the reports, add the missing
  # origins below, then rename this header to Content-Security-Policy.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://www.youtube.com https://s.ytimg.com https://player.vimeo.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.razorpay.com https://lumberjack.razorpay.com https://api.openai.com; frame-src 'self' https://www.youtube.com https://player.vimeo.com https://www.loom.com https://drive.google.com https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Hashed build assets are immutable — cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
