# Copy this file to scripts/.env.migration and fill in real values.
# scripts/.env.migration is git-ignored — never commit it, never paste its
# contents into chat. Everything below stays on your machine only.

# --- Supabase CLI auth ---
# Generate at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- OLD project (source) ---
OLD_PROJECT_REF=oblikiwelvgrfffbipaf
# Project Settings -> Database -> Connection string -> URI (has the DB password baked in)
OLD_DB_URL=postgresql://postgres:PASSWORD@db.oblikiwelvgrfffbipaf.supabase.co:5432/postgres
# Project Settings -> API -> service_role key
OLD_SERVICE_ROLE_KEY=
OLD_SUPABASE_URL=https://oblikiwelvgrfffbipaf.supabase.co

# --- NEW project (destination) ---
NEW_PROJECT_REF=
NEW_DB_URL=postgresql://postgres:PASSWORD@db.NEWPROJECTREF.supabase.co:5432/postgres
NEW_SERVICE_ROLE_KEY=
NEW_SUPABASE_URL=https://NEWPROJECTREF.supabase.co
NEW_ANON_KEY=

# --- Edge function secrets (only ones not auto-injected by Supabase) ---
LOVABLE_API_KEY=
