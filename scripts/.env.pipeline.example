# Copy this file to scripts/.env.pipeline and fill in real values, or export
# these in your shell before running scripts/vtt-chapters.mjs.
# scripts/.env.pipeline is git-ignored — never commit it.
#
# No AI provider key goes here. The script calls the app's own "ai-generate"
# edge function, which uses whichever provider/model the coach already
# connected under Settings > AI providers — same credentials, same billing.
#
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY are only needed here if the root
# .env doesn't already have VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY
# (the script falls back to those automatically).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ai-generate requires a signed-in user. Provide ONE of the following:

# Option A — a token you already have (e.g. copied from the browser while
# signed in, Application > Local Storage > the sb-*-auth-token entry).
# NOTE: deliberately not SUPABASE_ACCESS_TOKEN — that name is taken by the
# Supabase CLI/MCP for a management-API token, a different kind of credential
# that would silently get picked up here and rejected by ai-generate.
PIPELINE_USER_ACCESS_TOKEN=

# Option B — sign in as the coach whose AI providers should be used.
COACH_EMAIL=
COACH_PASSWORD=
