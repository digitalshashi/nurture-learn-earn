# Copy this file to .env and fill in the values, then restart `npm run dev`.
# .env is git-ignored. Without it the app renders a blank white page, because
# src/integrations/supabase/client.ts calls createClient() at import time and
# throws "supabaseUrl is required." before React mounts.
#
# These are the browser-safe Supabase values (the same ones baked into the
# deployed bundle) — NOT the service_role key, which must never appear here.
# Find them at: Supabase dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
