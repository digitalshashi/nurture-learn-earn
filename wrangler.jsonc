{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1corehub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-31",
  // Only this one hostname is bound to the Worker. Declaring the domain here
  // (rather than clicking it into the dashboard) means a fresh
  // `wrangler deploy` re-attaches it instead of silently dropping the site
  // back to the workers.dev URL.
  //
  // This was levelup.1corehub.com until the platform moved to
  // jointeluguai.com. 1corehub.com's nameservers went back to HostGator with
  // that move, which left no Cloudflare zone to attach to — deploys then
  // failed with "Can't infer zone from route" while still uploading the code,
  // so the Worker was current and unreachable at the same time. If that error
  // appears again, check whose nameservers the domain is on before anything
  // else.
  "routes": [
    {
      "pattern": "learn.jointeluguai.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every app route is client-side, so an unknown path is not a 404 — it is
    // the shell, and React Router decides from there.
    "not_found_handling": "single-page-application",
    // Static assets are normally served without ever waking the Worker, but
    // every HTML response needs its `<head>` rewritten before it leaves the
    // edge — a crawler reads nothing else. The negation keeps the hashed
    // bundle, which is the bulk of the traffic, on the pure asset path.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "observability": {
    "enabled": true
  }
}
